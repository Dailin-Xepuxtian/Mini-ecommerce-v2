PORT=3000
# Usa dos secretos distintos y largos (por ejemplo: openssl rand -hex 32)
JWT_SECRET=cambia_esto_por_un_secreto_largo
JWT_REFRESH_SECRET=cambia_esto_por_otro_secreto_distinto
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
DEFAULT_ROLE=cliente
DB_HOST=mysql
DB_PORT=3306
DB_USER=giganet
DB_PASSWORD=1234
DB_NAME=giganet_db
CORS_ORIGIN=http://localhost:5173

# --- Roles ---
ADMIN_ROLE=admin

# --- Colas (BullMQ + Redis) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Correo (en desarrollo: Mailpit en localhost:1025, interfaz web en :8025) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Galacticos S.A." <no-reply@galacticos.local>

# --- PDF de las órdenes de compra (api y worker deben compartir esta carpeta) ---
STORAGE_DIR=./storage

# --- Solo para la demo: hace fallar N intentos del correo para mostrar los reintentos ---
DEMO_FALLOS_CORREO=0

